{
  "name": "open-routing-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "docs:dev": "cd docs && npx --yes mint@4.2.873 dev --port 3001",
    "docs:check": "cd docs && npx --yes mint@4.2.873 validate && npx --yes mint@4.2.873 broken-links",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run knip && npm run typecheck && npm test",
    "dev": "npm run dev --workspace=@open-routing/demo",
    "dev:attio": "ATTIO_LIVE=1 node --env-file-if-exists=.env.local --import tsx apps/demo/src/server.ts",
    "dev:research": "RESEARCH_LIVE=1 node --env-file-if-exists=.env.local --env-file-if-exists=.env.research.local --import tsx apps/demo/src/server.ts",
    "test:attio:e2e": "node --env-file-if-exists=.env.local --import tsx apps/demo/scripts/attio-e2e.ts",
    "research:build": "docker build -t open-routing-research:local packages/research/sandbox",
    "test:research:live": "RUN_RESEARCH_INTEGRATION_TESTS=1 node --env-file-if-exists=.env.research.local node_modules/vitest/vitest.mjs run apps/demo/test/research.live.test.ts -t size-review",
    "test:research:review": "RUN_RESEARCH_INTEGRATION_TESTS=1 node --env-file-if-exists=.env.research.local node_modules/vitest/vitest.mjs run apps/demo/test/research.live.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:attio": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run packages/attio/test/live-attio.test.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
