{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "env": { "node": true },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/.data/**"],
  "overrides": [{ "files": ["**/public/**/*.js"], "env": { "browser": true, "node": false } }]
}
