# Optional: enables future live Attio contract tests. Default tests use fixtures.
ATTIO_API_KEY=
RUN_ATTIO_INTEGRATION_TESTS=0
ATTIO_LIVE=0
ATTIO_WORKSPACE_MEMBER_ID=
# Optional: fixed enrichment only for this end-to-end test domain.
ATTIO_E2E_DOMAIN=
ROUTING_BASE_URL=http://localhost:3002

# Example application
PORT=3000
PDL_API_KEY=

# Optional real Pi research (local .env.research.local; never commit credentials).
OPENROUTER_API_KEY=
PARALLEL_API_KEY=
RESEARCH_MODEL=openai/gpt-5.6-luna
