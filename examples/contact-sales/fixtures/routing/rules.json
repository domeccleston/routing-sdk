[
  {
    "id": "non-sales-request",
    "priority": 100,
    "when": { "field": "input.requestType", "operator": "not_equals", "value": "sales" },
    "outcome": { "type": "not_routed", "reason": "not_a_sales_request" }
  },
  {
    "id": "existing-crm-owner",
    "priority": 90,
    "when": { "field": "crm.owner.status", "operator": "equals", "value": "owned" },
    "outcome": { "type": "owner", "valueFrom": "crm.owner.id" }
  },
  {
    "id": "territory-match",
    "priority": 50,
    "when": { "field": "company.status", "operator": "equals", "value": "found" },
    "outcome": { "type": "territory" }
  },
  {
    "id": "unresolved-company",
    "priority": 10,
    "when": { "field": "company.status", "operator": "in", "value": ["not_found", "unavailable"] },
    "outcome": { "type": "unresolved", "reason": "company_data_unavailable" }
  }
]

