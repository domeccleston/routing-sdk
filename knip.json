{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["examples/*.test.ts", "scripts/*.mjs"],
      "project": ["*.ts", "examples/*.test.ts", "scripts/*.mjs"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/dashboard": {
      "entry": ["src/index.ts", "public/**/*.js"],
      "project": ["src/**/*.ts", "public/**/*.js"]
    },
    "examples/*": { "project": ["*.ts"] },
    "apps/*": {
      "entry": ["test/**/*.test.ts", "public/**/*.js"],
      "project": [
        "router.config.ts",
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "fixtures/**/*.ts",
        "public/**/*.js"
      ]
    }
  }
}
